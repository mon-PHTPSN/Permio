export sealed ledger targetNetworkHash: Bytes<32>;
export ledger authorityRoots: Map<Bytes<32>, AuthorityRootRecord>;
export ledger authorityRootUpdateProgress: Map<Bytes<32>, AuthorityRootUpdateProgress>;
export ledger authorityRootUpdateApprovals: Map<Bytes<32>, AuthorityRootUpdateApprovalRecord>;
export ledger proofModules: Map<Bytes<32>, ProofModuleRecord>;
export ledger proofModuleRegistrySequence: Counter;
export ledger proofModuleReviews: Map<Bytes<32>, ProofModuleReviewRecord>;
export ledger proofModuleApprovals: Map<Bytes<32>, ProofModuleApprovalRecord>;
export ledger usedProofModuleCommandNonces: Set<Bytes<32>>;
export ledger activationSessions: Map<Bytes<32>, ActivationStagingRecord>;
export ledger reservedAdmissionNonces: Map<Bytes<32>, Bytes<32>>;
export ledger activeTemplates: Map<Bytes<32>, ActiveTemplateRecord>;
export ledger usedAdmissionNonces: Set<Bytes<32>>;
export ledger templateActivationSequence: Counter;
export ledger templateLifecycleSequence: Counter;
export ledger usedTemplateLifecycleCommandNonces: Set<Bytes<32>>;
export ledger credentialStatusRoots: Map<Bytes<32>, CredentialStatusRootRecord>;
export ledger usedCredentialStatusCommandNonces: Set<Bytes<32>>;

constructor(
    networkHash: Bytes<32>,
    initialNamespaceHash: Bytes<32>,
    initialGovernancePolicyHash: Bytes<32>,
    initialAuthorityRoot: MerkleTreeDigest,
    initialRootVersion: Uint<64>,
    initialRootSequence: Uint<64>,
    initialCredentialStatusRoot: MerkleTreeDigest,
    moduleReviewThreshold: Uint<16>,
    moduleApprovalThreshold: Uint<16>,
    authorityRootUpdateThreshold: Uint<16>
) {
    targetNetworkHash = disclose(networkHash);
    authorityRoots.insert(
        disclose(initialNamespaceHash),
        disclose(
            AuthorityRootRecord{
                governancePolicyHash: initialGovernancePolicyHash,
                root: initialAuthorityRoot,
                rootVersion: initialRootVersion,
                rootSequence: initialRootSequence,
                moduleReviewThreshold: moduleReviewThreshold,
                moduleApprovalThreshold: moduleApprovalThreshold,
                authorityRootUpdateThreshold: authorityRootUpdateThreshold
            }
        )
    );
    credentialStatusRoots.insert(
        disclose(initialNamespaceHash),
        disclose(
            CredentialStatusRootRecord{
                root: initialCredentialStatusRoot,
                rootSequence: 0
            }
        )
    );
    assert(moduleReviewThreshold >= 2, "Module review threshold must be at least two");
    assert(moduleApprovalThreshold >= 2, "Module approval threshold must be at least two");
    assert(
        authorityRootUpdateThreshold >= 2,
        "Authority-root update threshold must be at least two"
    );
}

