// Private M5 assertions remain application-neutral and are not published.
// These bindings expose only fixed-size hashes and Midnight runtime keys to
// the proof system.  Their commitments are the identities used by the
// credential-status tree and by the runtime proof chain.
export struct RuntimeScopeRoots {
    actionsRoot: MerkleTreeDigest;
    resourceSelectorsRoot: MerkleTreeDigest;
    resourcesRoot: MerkleTreeDigest;
    purposesRoot: MerkleTreeDigest;
    recipientKindsRoot: MerkleTreeDigest;
    recipientsRoot: MerkleTreeDigest;
    disclosurePolicyIdsRoot: MerkleTreeDigest;
}

