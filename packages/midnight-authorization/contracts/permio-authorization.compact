export pure circuit proofModuleReviewSignatureChallenge(
    announcement: JubjubPoint,
    publicKey: JubjubPoint,
    review: ProofModuleReview
): Field {
    return Schnorr_schnorrChallenge(
        jubjubPointX(announcement),
        jubjubPointY(announcement),
        jubjubPointX(publicKey),
        jubjubPointY(publicKey),
        proofModuleReviewMessage(review)
    );
}

export pure circuit proofModuleLifecycleSignatureChallenge(
    announcement: JubjubPoint,
    publicKey: JubjubPoint,
    command: ProofModuleLifecycleCommand
): Field {
    return Schnorr_schnorrChallenge(
        jubjubPointX(announcement),
        jubjubPointY(announcement),
        jubjubPointX(publicKey),
        jubjubPointY(publicKey),
        proofModuleLifecycleCommandMessage(command)
    );
}

