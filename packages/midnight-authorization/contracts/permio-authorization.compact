export circuit verifyGovernanceActivationSignature(
    envelope: ActivationAdmissionEnvelope,
    signature: Schnorr_SchnorrSignature,
    publicKey: JubjubPoint
): [] {
    assert(envelope.envelopeVersion == 1, "Unsupported admission envelope version");
    assert(
        envelope.registryProtocolVersion == 1,
        "Unsupported registry protocol version"
    );
    Schnorr_schnorrVerify<1>(
        activationAdmissionMessage(envelope),
        signature,
        publicKey
    );
}

pure circuit templateRegistryKey(
    envelope: ActivationAdmissionEnvelope
): Bytes<32> {
    return persistentHash<TemplateRegistryTarget>(
        TemplateRegistryTarget{
            namespaceHash: envelope.namespaceHash,
            templateIdHash: envelope.templateIdHash,
            semanticVersion: envelope.semanticVersion,
            templateContentHash: envelope.templateContentHash
        }
    );
}

export pure circuit proofModuleRegistryKeyFromIdentity(
    identity: ProofModuleIdentity
): Bytes<32> {
    return persistentHash<ProofModuleIdentity>(identity);
}

pure circuit proofModuleRegistryKeyFromBinding(
    binding: ProofModuleBinding
): Bytes<32> {
    return proofModuleRegistryKeyFromIdentity(
        ProofModuleIdentity{
            moduleIdHash: binding.moduleIdHash,
            moduleVersion: binding.moduleVersion,
            implementationHash: binding.implementationHash
        }
    );
}

circuit verifyAdmissionAuthority(
    envelope: ActivationAdmissionEnvelope,
    signature: Schnorr_SchnorrSignature,
    activator: GovernanceActivatorLeaf,
    authorityPath: MerkleTreePath<20, Bytes<32>>
): [] {
    assert(envelope.envelopeVersion == 1, "Unsupported admission envelope version");
    assert(
        envelope.registryProtocolVersion == 1,
        "Unsupported registry protocol version"
    );
    assert(
        envelope.targetNetworkHash == targetNetworkHash,
        "Admission targets another Midnight network"
    );
    assert(
        envelope.targetContractIdentity == kernel.self().bytes,
        "Admission targets another contract deployment"
    );
    assert(
        authorityRoots.member(disclose(envelope.namespaceHash)),
        "No authority root is registered for the namespace"
    );
    const currentRoot = authorityRoots.lookup(disclose(envelope.namespaceHash));
    assert(
        envelope.governancePolicyHash == currentRoot.governancePolicyHash &&
        envelope.authorityRootVersion == currentRoot.rootVersion &&
        envelope.authorityRootSequence == currentRoot.rootSequence,
        "Admission authority root reference is stale or mismatched"
    );
    assert(
        activator.leafVersion == 1 &&
        activator.authorityKind == 3 &&
        activator.namespaceHash == envelope.namespaceHash &&
        activator.governancePolicyHash == envelope.governancePolicyHash,
        "Governance activator leaf is outside the admission scope"
    );
    assert(
        envelope.activatedAt >= activator.validAfter &&
        envelope.activatedAt < activator.validBefore,
        "Governance activator is outside its validity window"
    );
    const activatorCommitment = governanceActivatorLeafCommitment(activator);
    assert(
        authorityPath.leaf == activatorCommitment &&
        merkleTreePathRoot<20, Bytes<32>>(authorityPath) == currentRoot.root,
        "Governance activator is not eligible under the current authority root"
    );
    Schnorr_schnorrVerify<1>(
        activationAdmissionMessage(envelope),
        signature,
        activator.publicKey
    );
}

circuit verifyModuleAuthority(
    namespaceHash: Bytes<32>,
    governancePolicyHash: Bytes<32>,
    authorityRootVersion: Uint<64>,
    authorityRootSequence: Uint<64>,
    effectiveAt: Uint<64>,
    requiredAuthorityKind: Uint<16>,
    authority: GovernanceActivatorLeaf,
    authorityPath: MerkleTreePath<20, Bytes<32>>
): AuthorityRootRecord {
    assert(
        authorityRoots.member(disclose(namespaceHash)),
        "No authority root is registered for proof-module governance"
    );
    const currentRoot = authorityRoots.lookup(disclose(namespaceHash));
    assert(
        governancePolicyHash == currentRoot.governancePolicyHash &&
        authorityRootVersion == currentRoot.rootVersion &&
        authorityRootSequence == currentRoot.rootSequence,
        "Proof-module authority root reference is stale or mismatched"
    );
    assert(
        authority.leafVersion == 1 &&
        authority.authorityKind == requiredAuthorityKind &&
        authority.namespaceHash == namespaceHash &&
        authority.governancePolicyHash == governancePolicyHash,
        "Proof-module authority leaf is outside the required scope"
    );
    assert(
        effectiveAt >= authority.validAfter &&
        effectiveAt < authority.validBefore,
        "Proof-module authority is outside its validity window"
    );
    const authorityCommitment = governanceActivatorLeafCommitment(authority);
    assert(
        authorityPath.leaf == authorityCommitment &&
        merkleTreePathRoot<20, Bytes<32>>(authorityPath) == currentRoot.root,
        "Proof-module authority is not eligible under the current root"
    );
    return currentRoot;
}

circuit verifyAuthorityRootUpdate(
    command: AuthorityRootUpdateCommand,
    signature: Schnorr_SchnorrSignature,
    governor: GovernanceActivatorLeaf,
    authorityPath: MerkleTreePath<20, Bytes<32>>
): AuthorityRootRecord {
    assert(command.commandVersion == 1, "Unsupported authority-root update version");
    assert(
        authorityRoots.member(disclose(command.namespaceHash)),
        "No authority root is registered for the namespace"
    );
    const currentRoot = authorityRoots.lookup(disclose(command.namespaceHash));
    assert(
        command.currentGovernancePolicyHash == currentRoot.governancePolicyHash &&
        command.currentRoot == currentRoot.root &&
        command.currentRootVersion == currentRoot.rootVersion &&
        command.currentRootSequence == currentRoot.rootSequence,
        "Authority-root update does not bind the exact current root"
    );
    assert(
        command.nextRootVersion == currentRoot.rootVersion + 1 &&
        command.nextRootSequence == currentRoot.rootSequence + 1,
        "Authority-root version and sequence must advance exactly once"
    );
    assert(
        command.nextModuleReviewThreshold >= 2 &&
        command.nextModuleApprovalThreshold >= 2 &&
        command.nextAuthorityRootUpdateThreshold >= 2,
        "Authority-root update thresholds must be at least two"
    );
    assert(
        governor.leafVersion == 1 &&
        governor.authorityKind == 11 &&
        governor.namespaceHash == command.namespaceHash &&
        governor.governancePolicyHash == command.currentGovernancePolicyHash,
        "Authority-root governor leaf is outside the update scope"
    );
    assert(
        command.effectiveAt >= governor.validAfter &&
        command.effectiveAt < governor.validBefore,
        "Authority-root governor is outside its validity window"
    );
    const governorCommitment = governanceActivatorLeafCommitment(governor);
    assert(
        authorityPath.leaf == governorCommitment &&
        merkleTreePathRoot<20, Bytes<32>>(authorityPath) == currentRoot.root,
        "Authority-root governor is not eligible under the current root"
    );
    assert(
        blockTimeGte(disclose(command.effectiveAt)),
        "Authority-root update is not yet effective"
    );
    Schnorr_schnorrVerify<1>(
        authorityRootUpdateCommandMessage(command),
        signature,
        governor.publicKey
    );
    return currentRoot;
}

circuit commitAuthorityRootUpdateApproval(
    command: AuthorityRootUpdateCommand,
    currentRoot: AuthorityRootRecord,
    governor: GovernanceActivatorLeaf,
    previousAccumulator: Bytes<32>,
    nextCount: Uint<16>
): Uint<16> {
    const updateCommitment = authorityRootUpdateCommandCommitment(command);
    const governorCommitment = governanceActivatorLeafCommitment(governor);
    const approvalKey = persistentHash<AuthorityRootUpdateApprovalKey>(
        AuthorityRootUpdateApprovalKey{
            updateCommitment: updateCommitment,
            approverAuthorityCommitment: governorCommitment
        }
    );
    assert(
        !authorityRootUpdateApprovals.member(disclose(approvalKey)),
        "Duplicate authority-root governor approval"
    );
    const nextAccumulator = persistentHash<AuthorityRootUpdateApprovalStep>(
        AuthorityRootUpdateApprovalStep{
            previous: previousAccumulator,
            updateCommitment: updateCommitment,
            approverAuthorityCommitment: governorCommitment
        }
    );
    authorityRootUpdateApprovals.insert(
        disclose(approvalKey),
        disclose(
            AuthorityRootUpdateApprovalRecord{
                updateCommitment: updateCommitment,
                approverAuthorityCommitment: governorCommitment,
                approvedAt: command.effectiveAt
            }
        )
    );
    if (disclose(nextCount >= currentRoot.authorityRootUpdateThreshold)) {
        authorityRoots.insert(
            disclose(command.namespaceHash),
            disclose(
                AuthorityRootRecord{
                    governancePolicyHash: command.nextGovernancePolicyHash,
                    root: command.nextRoot,
                    rootVersion: command.nextRootVersion,
                    rootSequence: command.nextRootSequence,
                    moduleReviewThreshold: command.nextModuleReviewThreshold,
                    moduleApprovalThreshold: command.nextModuleApprovalThreshold,
                    authorityRootUpdateThreshold: command.nextAuthorityRootUpdateThreshold
                }
            )
        );
        authorityRootUpdateProgress.remove(disclose(updateCommitment));
    } else {
        authorityRootUpdateProgress.insert(
            disclose(updateCommitment),
            disclose(
                AuthorityRootUpdateProgress{
                    updateCommitment: updateCommitment,
                    approvalThreshold: currentRoot.authorityRootUpdateThreshold,
                    approvalCount: nextCount,
                    approvalEvidenceAccumulator: nextAccumulator
                }
            )
        );
    }
    return disclose(nextCount);
}

export circuit submitAuthorityRootApproval(
    command: AuthorityRootUpdateCommand,
    signature: Schnorr_SchnorrSignature,
    governor: GovernanceActivatorLeaf,
    authorityPath: MerkleTreePath<20, Bytes<32>>
): Uint<16> {
    const currentRoot = verifyAuthorityRootUpdate(
        command,
        signature,
        governor,
        authorityPath
    );
    const updateCommitment = authorityRootUpdateCommandCommitment(command);
    if (authorityRootUpdateProgress.member(disclose(updateCommitment))) {
        const progress = authorityRootUpdateProgress.lookup(disclose(updateCommitment));
        assert(
            progress.updateCommitment == updateCommitment &&
            progress.approvalThreshold == currentRoot.authorityRootUpdateThreshold,
            "Authority-root approval progress is stale or mismatched"
        );
        return commitAuthorityRootUpdateApproval(
            command,
            currentRoot,
            governor,
            progress.approvalEvidenceAccumulator,
            (progress.approvalCount + 1) as Uint<16>
        );
    } else {
        return commitAuthorityRootUpdateApproval(
            command,
            currentRoot,
            governor,
            default<Bytes<32>>,
            1
        );
    }
}

circuit assertModuleCommandTarget(
    command: ProofModuleLifecycleCommand,
    record: ProofModuleRecord
): [] {
    assert(
        command.commandVersion == 1 &&
        command.recordCommitment == persistentHash<ProofModuleRecord>(record) &&
        command.governanceNamespaceHash == record.governanceNamespaceHash &&
        command.expectedLifecycleStatus == record.lifecycleStatus,
        "Proof-module command does not bind the exact current record"
    );
    assert(
        !usedProofModuleCommandNonces.member(disclose(command.commandNonce)),
        "Proof-module command nonce already used"
    );
}

circuit updatedProofModuleRecord(
    record: ProofModuleRecord,
    nextStatus: Uint<8>,
    approvalEvidenceCommitment: Bytes<32>,
    activationSequence: Uint<64>,
    reviewedAt: Uint<64>,
    approvedAt: Uint<64>,
    activatedAt: Uint<64>,
    deprecatedAt: Uint<64>,
    revokedAt: Uint<64>
): ProofModuleRecord {
    return ProofModuleRecord{
        identity: record.identity,
        proposalCommitment: record.proposalCommitment,
        governanceNamespaceHash: record.governanceNamespaceHash,
        governancePolicyHash: record.governancePolicyHash,
        authorityRootVersion: record.authorityRootVersion,
        authorityRootSequence: record.authorityRootSequence,
        implementationReferenceHash: record.implementationReferenceHash,
        sourceHash: record.sourceHash,
        inputSchemaHash: record.inputSchemaHash,
        configurationSchemaHash: record.configurationSchemaHash,
        receiptSchemaHash: record.receiptSchemaHash,
        compilerVersionHash: record.compilerVersionHash,
        compatibilityPolicyHash: record.compatibilityPolicyHash,
        approvalEvidenceCommitment: approvalEvidenceCommitment,
        reviewThreshold: record.reviewThreshold,
        reviewCount: record.reviewCount,
        reviewEvidenceAccumulator: record.reviewEvidenceAccumulator,
        approvalThreshold: record.approvalThreshold,
        approvalCount: record.approvalCount,
        approvalEvidenceAccumulator: record.approvalEvidenceAccumulator,
        lifecycleStatus: nextStatus,
        activationSequence: activationSequence,
        proposedAt: record.proposedAt,
        reviewedAt: reviewedAt,
        approvedAt: approvedAt,
        activatedAt: activatedAt,
        deprecatedAt: deprecatedAt,
        revokedAt: revokedAt
    };
}

export circuit proposeProofModule(
    proposal: ProofModuleProposal
): Bytes<32> {
    assert(proposal.proposalVersion == 1, "Unsupported proof-module proposal version");
    assert(
        authorityRoots.member(disclose(proposal.governanceNamespaceHash)),
        "No authority root is registered for proof-module governance"
    );
    const currentRoot = authorityRoots.lookup(disclose(proposal.governanceNamespaceHash));
    assert(
        proposal.governancePolicyHash == currentRoot.governancePolicyHash &&
        proposal.authorityRootVersion == currentRoot.rootVersion &&
        proposal.authorityRootSequence == currentRoot.rootSequence,
        "Proof-module proposal authority root reference is stale or mismatched"
    );
    const moduleKey = proofModuleRegistryKeyFromIdentity(proposal.identity);
    assert(
        !proofModules.member(disclose(moduleKey)),
        "Exact proof-module implementation is already registered"
    );
    proofModules.insert(
        disclose(moduleKey),
        disclose(
            ProofModuleRecord{
                identity: proposal.identity,
                proposalCommitment: proofModuleProposalCommitment(proposal),
                governanceNamespaceHash: proposal.governanceNamespaceHash,
                governancePolicyHash: proposal.governancePolicyHash,
                authorityRootVersion: proposal.authorityRootVersion,
                authorityRootSequence: proposal.authorityRootSequence,
                implementationReferenceHash: proposal.implementationReferenceHash,
                sourceHash: proposal.sourceHash,
                inputSchemaHash: proposal.inputSchemaHash,
                configurationSchemaHash: proposal.configurationSchemaHash,
                receiptSchemaHash: proposal.receiptSchemaHash,
                compilerVersionHash: proposal.compilerVersionHash,
                compatibilityPolicyHash: proposal.compatibilityPolicyHash,
                approvalEvidenceCommitment: default<Bytes<32>>,
                reviewThreshold: currentRoot.moduleReviewThreshold,
                reviewCount: 0,
                reviewEvidenceAccumulator: default<Bytes<32>>,
                approvalThreshold: currentRoot.moduleApprovalThreshold,
                approvalCount: 0,
                approvalEvidenceAccumulator: default<Bytes<32>>,
                lifecycleStatus: 1,
                activationSequence: 0,
                proposedAt: proposal.proposedAt,
                reviewedAt: 0,
                approvedAt: 0,
                activatedAt: 0,
                deprecatedAt: 0,
                revokedAt: 0
            }
        )
    );
    proofModuleRegistrySequence.increment(1);
    return disclose(moduleKey);
}

export circuit reviewProofModule(
    review: ProofModuleReview,
    signature: Schnorr_SchnorrSignature,
    reviewer: GovernanceActivatorLeaf,
    authorityPath: MerkleTreePath<20, Bytes<32>>
): Uint<16> {
    assert(review.reviewVersion == 1, "Unsupported proof-module review version");
    assert(
        proofModules.member(disclose(review.moduleKey)),
        "Proof module is not registered"
    );
    const record = proofModules.lookup(disclose(review.moduleKey));
    assert(
        record.lifecycleStatus == 1,
        "Proof module no longer accepts reviews"
    );
    assert(
        review.proposalCommitment == record.proposalCommitment &&
        review.governanceNamespaceHash == record.governanceNamespaceHash &&
        review.governancePolicyHash == record.governancePolicyHash &&
        review.authorityRootVersion == record.authorityRootVersion &&
        review.authorityRootSequence == record.authorityRootSequence,
        "Proof-module review does not bind the exact proposal"
    );
    verifyModuleAuthority(
        review.governanceNamespaceHash,
        review.governancePolicyHash,
        review.authorityRootVersion,
        review.authorityRootSequence,
        review.reviewedAt,
        7,
        reviewer,
        authorityPath
    );
    assert(
        !usedProofModuleCommandNonces.member(disclose(review.reviewNonce)),
        "Proof-module review nonce already used"
    );
    Schnorr_schnorrVerify<1>(
        proofModuleReviewMessage(review),
        signature,
        reviewer.publicKey
    );
    const reviewerCommitment = governanceActivatorLeafCommitment(reviewer);
    const reviewKey = persistentHash<ProofModuleReviewKey>(
        ProofModuleReviewKey{
            moduleKey: review.moduleKey,
            reviewerAuthorityCommitment: reviewerCommitment
        }
    );
    assert(
        !proofModuleReviews.member(disclose(reviewKey)),
        "Duplicate proof-module reviewer approval"
    );
    const reviewCommitment = proofModuleReviewCommitment(review);
    const nextAccumulator = persistentHash<ProofModuleReviewAccumulatorStep>(
        ProofModuleReviewAccumulatorStep{
            previous: record.reviewEvidenceAccumulator,
            reviewCommitment: reviewCommitment,
            reviewerAuthorityCommitment: reviewerCommitment
        }
    );
    const nextCount = (record.reviewCount + 1) as Uint<16>;
    const thresholdReached = disclose(nextCount >= record.reviewThreshold);
    const reviewedRecord = ProofModuleRecord{
        identity: record.identity,
        proposalCommitment: record.proposalCommitment,
        governanceNamespaceHash: record.governanceNamespaceHash,
        governancePolicyHash: record.governancePolicyHash,
        authorityRootVersion: record.authorityRootVersion,
        authorityRootSequence: record.authorityRootSequence,
        implementationReferenceHash: record.implementationReferenceHash,
        sourceHash: record.sourceHash,
        inputSchemaHash: record.inputSchemaHash,
        configurationSchemaHash: record.configurationSchemaHash,
        receiptSchemaHash: record.receiptSchemaHash,
        compilerVersionHash: record.compilerVersionHash,
        compatibilityPolicyHash: record.compatibilityPolicyHash,
        approvalEvidenceCommitment: record.approvalEvidenceCommitment,
        reviewThreshold: record.reviewThreshold,
        reviewCount: nextCount,
        reviewEvidenceAccumulator: nextAccumulator,
        approvalThreshold: record.approvalThreshold,
        approvalCount: record.approvalCount,
        approvalEvidenceAccumulator: record.approvalEvidenceAccumulator,
        lifecycleStatus: record.lifecycleStatus,
        activationSequence: record.activationSequence,
        proposedAt: record.proposedAt,
        reviewedAt: record.reviewedAt,
        approvedAt: record.approvedAt,
        activatedAt: record.activatedAt,
        deprecatedAt: record.deprecatedAt,
        revokedAt: record.revokedAt
    };
    usedProofModuleCommandNonces.insert(disclose(review.reviewNonce));
    proofModuleReviews.insert(
        disclose(reviewKey),
        disclose(
            ProofModuleReviewRecord{
                moduleKey: review.moduleKey,
                reviewerAuthorityCommitment: reviewerCommitment,
                reviewCommitment: reviewCommitment,
                reviewedAt: review.reviewedAt
            }
        )
    );
    if (thresholdReached) {
        proofModules.insert(
            disclose(review.moduleKey),
            disclose(
                updatedProofModuleRecord(
                    reviewedRecord,
                    2,
                    record.approvalEvidenceCommitment,
                    record.activationSequence,
                    review.reviewedAt,
                    record.approvedAt,
                    record.activatedAt,
                    record.deprecatedAt,
                    record.revokedAt
                )
            )
        );
    } else {
        proofModules.insert(disclose(review.moduleKey), disclose(reviewedRecord));
    }
    proofModuleRegistrySequence.increment(1);
    return disclose(nextCount);
}

circuit verifyProofModuleLifecycleCommand(
    command: ProofModuleLifecycleCommand,
    signature: Schnorr_SchnorrSignature,
    authority: GovernanceActivatorLeaf,
    authorityPath: MerkleTreePath<20, Bytes<32>>,
    requiredAuthorityKind: Uint<16>
): ProofModuleRecord {
    assert(
        proofModules.member(disclose(command.moduleKey)),
        "Proof module is not registered"
    );
    const record = proofModules.lookup(disclose(command.moduleKey));
    assertModuleCommandTarget(command, record);
    verifyModuleAuthority(
        command.governanceNamespaceHash,
        command.governancePolicyHash,
        command.authorityRootVersion,
        command.authorityRootSequence,
        command.effectiveAt,
        requiredAuthorityKind,
        authority,
        authorityPath
    );
    assert(
        blockTimeGte(disclose(command.effectiveAt)),
        "Proof-module lifecycle command is not yet effective"
    );
    Schnorr_schnorrVerify<1>(
        proofModuleLifecycleCommandMessage(command),
        signature,
        authority.publicKey
    );
    return record;
}

circuit commitProofModuleLifecycle(
    command: ProofModuleLifecycleCommand,
    record: ProofModuleRecord
): [] {
    usedProofModuleCommandNonces.insert(disclose(command.commandNonce));
    proofModules.insert(disclose(command.moduleKey), disclose(record));
    proofModuleRegistrySequence.increment(1);
}

export circuit governProofModule(
    command: ProofModuleLifecycleCommand,
    signature: Schnorr_SchnorrSignature,
    authority: GovernanceActivatorLeaf,
    authorityPath: MerkleTreePath<20, Bytes<32>>
): Uint<16> {
    if (disclose(command.nextLifecycleStatus == 3)) {
        const record = verifyProofModuleLifecycleCommand(
            command,
            signature,
            authority,
            authorityPath,
            8
        );
        assert(
            command.expectedLifecycleStatus == 2 &&
            command.nextLifecycleStatus == 3 &&
            record.reviewCount >= record.reviewThreshold,
            "Proof module has not completed the required independent review"
        );
        const approverCommitment = governanceActivatorLeafCommitment(authority);
        const approvalKey = persistentHash<ProofModuleApprovalKey>(
            ProofModuleApprovalKey{
                moduleKey: command.moduleKey,
                approverAuthorityCommitment: approverCommitment
            }
        );
        assert(
            !proofModuleApprovals.member(disclose(approvalKey)),
            "Duplicate proof-module approver approval"
        );
        const approvalCommitment = persistentHash<ProofModuleLifecycleCommand>(command);
        const nextAccumulator = persistentHash<ProofModuleApprovalAccumulatorStep>(
            ProofModuleApprovalAccumulatorStep{
                previous: record.approvalEvidenceAccumulator,
                approvalCommitment: approvalCommitment,
                approverAuthorityCommitment: approverCommitment
            }
        );
        const nextCount = (record.approvalCount + 1) as Uint<16>;
        const thresholdReached = disclose(nextCount >= record.approvalThreshold);
        const approvedRecord = ProofModuleRecord{
            identity: record.identity,
            proposalCommitment: record.proposalCommitment,
            governanceNamespaceHash: record.governanceNamespaceHash,
            governancePolicyHash: record.governancePolicyHash,
            authorityRootVersion: record.authorityRootVersion,
            authorityRootSequence: record.authorityRootSequence,
            implementationReferenceHash: record.implementationReferenceHash,
            sourceHash: record.sourceHash,
            inputSchemaHash: record.inputSchemaHash,
            configurationSchemaHash: record.configurationSchemaHash,
            receiptSchemaHash: record.receiptSchemaHash,
            compilerVersionHash: record.compilerVersionHash,
            compatibilityPolicyHash: record.compatibilityPolicyHash,
            approvalEvidenceCommitment: record.approvalEvidenceCommitment,
            reviewThreshold: record.reviewThreshold,
            reviewCount: record.reviewCount,
            reviewEvidenceAccumulator: record.reviewEvidenceAccumulator,
            approvalThreshold: record.approvalThreshold,
            approvalCount: nextCount,
            approvalEvidenceAccumulator: nextAccumulator,
            lifecycleStatus: record.lifecycleStatus,
            activationSequence: record.activationSequence,
            proposedAt: record.proposedAt,
            reviewedAt: record.reviewedAt,
            approvedAt: record.approvedAt,
            activatedAt: record.activatedAt,
            deprecatedAt: record.deprecatedAt,
            revokedAt: record.revokedAt
        };
        usedProofModuleCommandNonces.insert(disclose(command.commandNonce));
        proofModuleApprovals.insert(
            disclose(approvalKey),
            disclose(
                ProofModuleApprovalRecord{
                    moduleKey: command.moduleKey,
                    approverAuthorityCommitment: approverCommitment,
                    approvalCommitment: approvalCommitment,
                    approvedAt: command.effectiveAt
                }
            )
        );
        if (thresholdReached) {
            proofModules.insert(
                disclose(command.moduleKey),
                disclose(
                    updatedProofModuleRecord(
                        approvedRecord,
                        3,
                        nextAccumulator,
                        record.activationSequence,
                        record.reviewedAt,
                        command.effectiveAt,
                        record.activatedAt,
                        record.deprecatedAt,
                        record.revokedAt
                    )
                )
            );
        } else {
            proofModules.insert(disclose(command.moduleKey), disclose(approvedRecord));
        }
        proofModuleRegistrySequence.increment(1);
        return disclose(nextCount);
    } else if (disclose(command.nextLifecycleStatus == 4)) {
        const record = verifyProofModuleLifecycleCommand(
            command,
            signature,
            authority,
            authorityPath,
            9
        );
        assert(
            command.expectedLifecycleStatus == 3 &&
            command.nextLifecycleStatus == 4,
            "Invalid proof-module activation transition"
        );
        const updated = updatedProofModuleRecord(
            record,
            4,
            record.approvalEvidenceCommitment,
            proofModuleRegistrySequence.read(),
            record.reviewedAt,
            record.approvedAt,
            command.effectiveAt,
            record.deprecatedAt,
            record.revokedAt
        );
        commitProofModuleLifecycle(command, updated);
        return disclose(record.approvalCount);
    } else if (disclose(command.nextLifecycleStatus == 5)) {
        const record = verifyProofModuleLifecycleCommand(
            command,
            signature,
            authority,
            authorityPath,
            8
        );
        assert(
            command.expectedLifecycleStatus == 4 &&
            command.nextLifecycleStatus == 5,
            "Invalid proof-module deprecation transition"
        );
        const updated = updatedProofModuleRecord(
            record,
            5,
            record.approvalEvidenceCommitment,
            record.activationSequence,
            record.reviewedAt,
            record.approvedAt,
            record.activatedAt,
            command.effectiveAt,
            record.revokedAt
        );
        commitProofModuleLifecycle(command, updated);
        return disclose(record.approvalCount);
    } else {
        const record = verifyProofModuleLifecycleCommand(
            command,
            signature,
            authority,
            authorityPath,
            10
        );
        assert(
            (command.expectedLifecycleStatus == 4 ||
                command.expectedLifecycleStatus == 5) &&
            command.nextLifecycleStatus == 6,
            "Invalid proof-module revocation transition"
        );
        const updated = updatedProofModuleRecord(
            record,
            6,
            record.approvalEvidenceCommitment,
            record.activationSequence,
            record.reviewedAt,
            record.approvedAt,
            record.activatedAt,
            record.deprecatedAt,
            command.effectiveAt
        );
        commitProofModuleLifecycle(command, updated);
        return disclose(record.approvalCount);
    }
}

circuit verifyTemplateLifecycleCommand(
    command: TemplateLifecycleCommand,
    signature: Schnorr_SchnorrSignature,
    authority: GovernanceActivatorLeaf,
    authorityPath: MerkleTreePath<20, Bytes<32>>,
    requiredAuthorityKind: Uint<16>
): ActiveTemplateRecord {
    assert(command.commandVersion == 1, "Unsupported template lifecycle command version");
    assert(
        activeTemplates.member(disclose(command.registryKey)),
        "Exact template version is not registered"
    );
    const record = activeTemplates.lookup(disclose(command.registryKey));
    assert(
        command.recordCommitment == activeTemplateRecordCommitment(record) &&
        command.namespaceHash == record.target.namespaceHash &&
        command.expectedLifecycleStatus == record.lifecycleStatus,
        "Template lifecycle command does not bind the exact current record"
    );
    assert(
        !usedTemplateLifecycleCommandNonces.member(disclose(command.commandNonce)),
        "Template lifecycle command nonce already used"
    );
    assert(
        authorityRoots.member(disclose(command.namespaceHash)),
        "No authority root is registered for the template namespace"
    );
    const currentRoot = authorityRoots.lookup(disclose(command.namespaceHash));
    assert(
        command.governancePolicyHash == currentRoot.governancePolicyHash &&
        command.authorityRootVersion == currentRoot.rootVersion &&
        command.authorityRootSequence == currentRoot.rootSequence,
        "Template lifecycle authority root reference is stale or mismatched"
    );
    assert(
        authority.leafVersion == 1 &&
        authority.authorityKind == requiredAuthorityKind &&
        authority.namespaceHash == command.namespaceHash &&
        authority.governancePolicyHash == command.governancePolicyHash,
        "Template lifecycle authority leaf is outside the required scope"
    );
    assert(
        command.effectiveAt >= authority.validAfter &&
        command.effectiveAt < authority.validBefore,
        "Template lifecycle authority is outside its validity window"
    );
    const authorityCommitment = governanceActivatorLeafCommitment(authority);
    assert(
        authorityPath.leaf == authorityCommitment &&
        merkleTreePathRoot<20, Bytes<32>>(authorityPath) == currentRoot.root,
        "Template lifecycle authority is not eligible under the current root"
    );
    assert(
        command.effectiveSequence == templateLifecycleSequence.read() + 1,
        "Template lifecycle sequence is stale or skips history"
    );
    assert(
        blockTimeGte(disclose(command.effectiveAt)),
        "Template lifecycle command is not yet effective"
    );
    Schnorr_schnorrVerify<1>(
        templateLifecycleCommandMessage(command),
        signature,
        authority.publicKey
    );
    return record;
}

circuit updatedActiveTemplateRecord(
    record: ActiveTemplateRecord,
    lifecycleStatus: Uint<8>,
    terminationEffectiveSequence: Uint<64>,
    terminationReasonHash: Bytes<32>,
    retiredAt: Uint<64>,
    revokedAt: Uint<64>
): ActiveTemplateRecord {
    return ActiveTemplateRecord{
        target: record.target,
        governancePolicyHash: record.governancePolicyHash,
        proofModuleBindingsHash: record.proofModuleBindingsHash,
        proofModuleBindingRoot: record.proofModuleBindingRoot,
        proofModuleBindingCount: record.proofModuleBindingCount,
        proofModuleRegistrySequence: record.proofModuleRegistrySequence,
        stagedBindingsAccumulator: record.stagedBindingsAccumulator,
        m4ActivationRecordHash: record.m4ActivationRecordHash,
        approvalEvidenceCommitment: record.approvalEvidenceCommitment,
        authorityRootVersion: record.authorityRootVersion,
        authorityRootSequence: record.authorityRootSequence,
        lifecycleStatus: lifecycleStatus,
        activationSequence: record.activationSequence,
        activatedAt: record.activatedAt,
        terminationEffectiveSequence: terminationEffectiveSequence,
        terminationReasonHash: terminationReasonHash,
        retiredAt: retiredAt,
        revokedAt: revokedAt
    };
}

circuit commitTemplateLifecycle(
    command: TemplateLifecycleCommand,
    record: ActiveTemplateRecord
): [] {
    usedTemplateLifecycleCommandNonces.insert(disclose(command.commandNonce));
    activeTemplates.insert(disclose(command.registryKey), disclose(record));
    templateLifecycleSequence.increment(1);
}

export circuit terminateTemplate(
    command: TemplateLifecycleCommand,
    signature: Schnorr_SchnorrSignature,
    authority: GovernanceActivatorLeaf,
    authorityPath: MerkleTreePath<20, Bytes<32>>
): Boolean {
    if (disclose(command.nextLifecycleStatus == 2)) {
        const record = verifyTemplateLifecycleCommand(
            command,
            signature,
            authority,
            authorityPath,
            12
        );
        assert(
            command.expectedLifecycleStatus == 1 &&
            command.nextLifecycleStatus == 2,
            "Invalid template retirement transition"
        );
        commitTemplateLifecycle(
            command,
            updatedActiveTemplateRecord(
                record,
                2,
                command.effectiveSequence,
                command.reasonHash,
                command.effectiveAt,
                record.revokedAt
            )
        );
        return true;
    } else {
        const record = verifyTemplateLifecycleCommand(
            command,
            signature,
            authority,
            authorityPath,
            5
        );
        assert(
            (command.expectedLifecycleStatus == 1 ||
                command.expectedLifecycleStatus == 2) &&
            command.nextLifecycleStatus == 3,
            "Invalid template revocation transition"
        );
        commitTemplateLifecycle(
            command,
            updatedActiveTemplateRecord(
                record,
                3,
                command.effectiveSequence,
                command.reasonHash,
                record.retiredAt,
                command.effectiveAt
            )
        );
        return true;
    }
}

circuit removeActivationSession(
    registryKey: Bytes<32>,
    session: ActivationStagingRecord
): [] {
    activationSessions.remove(disclose(registryKey));
    reservedAdmissionNonces.remove(disclose(session.admissionNonce));
}

circuit activationSessionStale(session: ActivationStagingRecord): Boolean {
    if (!authorityRoots.member(disclose(session.namespaceHash))) {
        return true;
    }
    const currentRoot = authorityRoots.lookup(disclose(session.namespaceHash));
    return disclose(
        session.proofModuleRegistrySequence != proofModuleRegistrySequence.read() ||
        session.governancePolicyHash != currentRoot.governancePolicyHash ||
        session.authorityRootVersion != currentRoot.rootVersion ||
        session.authorityRootSequence != currentRoot.rootSequence
    );
}

export circuit beginM4Activation(
    envelope: ActivationAdmissionEnvelope,
    signature: Schnorr_SchnorrSignature,
    activator: GovernanceActivatorLeaf,
    authorityPath: MerkleTreePath<20, Bytes<32>>
): Bytes<32> {
    verifyAdmissionAuthority(envelope, signature, activator, authorityPath);
    assert(envelope.proofModuleBindingCount > 0, "Binding manifest cannot be empty");
    assert(
        envelope.proofModuleRegistrySequence == proofModuleRegistrySequence.read(),
        "Proof-module registry sequence is stale"
    );
    assert(
        blockTimeLt(disclose(envelope.stagingExpiresAt)),
        "Activation staging deadline has passed"
    );
    assert(
        !usedAdmissionNonces.member(disclose(envelope.admissionNonce)),
        "Admission nonce already used"
    );

    const registryKey = templateRegistryKey(envelope);
    assert(
        !activeTemplates.member(disclose(registryKey)),
        "Exact template version is already registered"
    );
    if (activationSessions.member(disclose(registryKey))) {
        const previous = activationSessions.lookup(disclose(registryKey));
        if (blockTimeGte(previous.expiresAt) || activationSessionStale(previous)) {
            removeActivationSession(registryKey, previous);
        } else {
            assert(false, "An activation session already exists for this template version");
        }
    }
    assert(
        !reservedAdmissionNonces.member(disclose(envelope.admissionNonce)),
        "Admission nonce is reserved by another activation session"
    );
    const session = ActivationStagingRecord{
        envelopeCommitment: activationAdmissionEnvelopeCommitment(envelope),
        namespaceHash: envelope.namespaceHash,
        governancePolicyHash: envelope.governancePolicyHash,
        authorityRootVersion: envelope.authorityRootVersion,
        authorityRootSequence: envelope.authorityRootSequence,
        proofModuleBindingsHash: envelope.proofModuleBindingsHash,
        proofModuleBindingRoot: envelope.proofModuleBindingRoot,
        proofModuleBindingCount: envelope.proofModuleBindingCount,
        proofModuleRegistrySequence: envelope.proofModuleRegistrySequence,
        nextBindingIndex: 0,
        stagedBindingsAccumulator: default<Bytes<32>>,
        admissionNonce: envelope.admissionNonce,
        expiresAt: envelope.stagingExpiresAt
    };
    activationSessions.insert(disclose(registryKey), disclose(session));
    reservedAdmissionNonces.insert(
        disclose(envelope.admissionNonce),
        disclose(registryKey)
    );
    return disclose(registryKey);
}

export circuit stageM4ActivationBinding(
    registryKey: Bytes<32>,
    binding: ProofModuleBinding,
    bindingPath: MerkleTreePath<20, Bytes<32>>
): Boolean {
    assert(
        activationSessions.member(disclose(registryKey)),
        "Activation session does not exist"
    );
    const session = activationSessions.lookup(disclose(registryKey));
    if (blockTimeGte(session.expiresAt) || activationSessionStale(session)) {
        removeActivationSession(registryKey, session);
        return false;
    }
    assert(
        session.proofModuleRegistrySequence == proofModuleRegistrySequence.read(),
        "Proof-module registry changed during activation staging"
    );
    assert(
        binding.bindingVersion == 1 &&
        binding.actionIndex == session.nextBindingIndex &&
        binding.actionIndex < session.proofModuleBindingCount,
        "Binding index is duplicate, missing, or out of canonical order"
    );
    const bindingCommitment = proofModuleBindingCommitment(binding);
    assert(
        bindingPath.leaf == bindingCommitment &&
        merkleTreePathRoot<20, Bytes<32>>(bindingPath) == session.proofModuleBindingRoot,
        "Binding is not part of the signed manifest"
    );
    const moduleKey = proofModuleRegistryKeyFromBinding(binding);
    assert(
        proofModules.member(disclose(moduleKey)),
        "Proof module is not registered"
    );
    const moduleRecord = proofModules.lookup(disclose(moduleKey));
    assert(
        moduleRecord.lifecycleStatus == 4,
        "Proof module is not active for new template activation"
    );
    assert(
        moduleRecord.receiptSchemaHash == binding.receiptSchemaHash,
        "Binding receipt schema does not match the registered proof module"
    );
    const nextAccumulator = persistentHash<BindingAccumulatorStep>(
        BindingAccumulatorStep{
            previous: session.stagedBindingsAccumulator,
            bindingCommitment: bindingCommitment,
            actionIndex: binding.actionIndex
        }
    );
    activationSessions.insert(
        disclose(registryKey),
        disclose(
            ActivationStagingRecord{
                envelopeCommitment: session.envelopeCommitment,
                namespaceHash: session.namespaceHash,
                governancePolicyHash: session.governancePolicyHash,
                authorityRootVersion: session.authorityRootVersion,
                authorityRootSequence: session.authorityRootSequence,
                proofModuleBindingsHash: session.proofModuleBindingsHash,
                proofModuleBindingRoot: session.proofModuleBindingRoot,
                proofModuleBindingCount: session.proofModuleBindingCount,
                proofModuleRegistrySequence: session.proofModuleRegistrySequence,
                nextBindingIndex: (session.nextBindingIndex + 1) as Uint<32>,
                stagedBindingsAccumulator: nextAccumulator,
                admissionNonce: session.admissionNonce,
                expiresAt: session.expiresAt
            }
        )
    );
    return true;
}

export circuit finalizeM4Activation(
    envelope: ActivationAdmissionEnvelope,
    signature: Schnorr_SchnorrSignature,
    activator: GovernanceActivatorLeaf,
    authorityPath: MerkleTreePath<20, Bytes<32>>
): FinalizationResult {
    const registryKey = templateRegistryKey(envelope);
    assert(
        activationSessions.member(disclose(registryKey)),
        "Activation session does not exist"
    );
    const session = activationSessions.lookup(disclose(registryKey));
    if (blockTimeGte(session.expiresAt) || activationSessionStale(session)) {
        removeActivationSession(registryKey, session);
        return disclose(FinalizationResult{activated: false, registryKey: registryKey});
    }
    verifyAdmissionAuthority(envelope, signature, activator, authorityPath);
    assert(
        activationAdmissionEnvelopeCommitment(envelope) == session.envelopeCommitment,
        "Activation envelope does not match the staged session"
    );
    assert(
        session.proofModuleRegistrySequence == proofModuleRegistrySequence.read(),
        "Proof-module registry changed during activation staging"
    );
    assert(
        session.nextBindingIndex == session.proofModuleBindingCount,
        "Not every action binding has been staged"
    );
    assert(
        !usedAdmissionNonces.member(disclose(envelope.admissionNonce)),
        "Admission nonce already used"
    );
    assert(
        !activeTemplates.member(disclose(registryKey)),
        "Exact template version is already registered"
    );

    templateLifecycleSequence.increment(1);
    const sequence = templateLifecycleSequence.read();
    usedAdmissionNonces.insert(disclose(envelope.admissionNonce));
    activeTemplates.insert(
        disclose(registryKey),
        disclose(
            ActiveTemplateRecord{
                target: TemplateRegistryTarget{
                    namespaceHash: envelope.namespaceHash,
                    templateIdHash: envelope.templateIdHash,
                    semanticVersion: envelope.semanticVersion,
                    templateContentHash: envelope.templateContentHash
                },
                governancePolicyHash: envelope.governancePolicyHash,
                proofModuleBindingsHash: envelope.proofModuleBindingsHash,
                proofModuleBindingRoot: envelope.proofModuleBindingRoot,
                proofModuleBindingCount: envelope.proofModuleBindingCount,
                proofModuleRegistrySequence: envelope.proofModuleRegistrySequence,
                stagedBindingsAccumulator: session.stagedBindingsAccumulator,
                m4ActivationRecordHash: envelope.m4ActivationRecordHash,
                approvalEvidenceCommitment: envelope.approvalEvidenceCommitment,
                authorityRootVersion: envelope.authorityRootVersion,
                authorityRootSequence: envelope.authorityRootSequence,
                lifecycleStatus: 1 as Uint<8>,
                activationSequence: sequence,
                activatedAt: envelope.activatedAt,
                terminationEffectiveSequence: 0 as Uint<64>,
                terminationReasonHash: default<Bytes<32>>,
                retiredAt: 0 as Uint<64>,
                revokedAt: 0 as Uint<64>
            }
        )
    );
    removeActivationSession(registryKey, session);
    templateActivationSequence.increment(1);
    return disclose(FinalizationResult{activated: true, registryKey: registryKey});
}

export circuit updateRuntimeCredentialStatus(
    command: RuntimeCredentialStatusCommand,
    signature: Schnorr_SchnorrSignature,
    namespaceAuthority: GovernanceActivatorLeaf,
    namespaceAuthorityPath: MerkleTreePath<20, Bytes<32>>,
    accountAuthority: RuntimeAccountCredential,
    accountAuthorityStatusPath: MerkleTreePath<20, Bytes<32>>,
    currentStatusPath: MerkleTreePath<20, Bytes<32>>
): Uint<64> {
    assert(command.commandVersion == 1, "Unsupported credential-status command version");
    assert(
        command.credentialKind >= 1 && command.credentialKind <= 3,
        "Credential kind must be account, capability, or session"
    );
    assert(
        (command.expectedStatus == 0 && command.nextStatus == 1) ||
        (command.expectedStatus == 1 && command.nextStatus == 2),
        "Credential status transition must be empty-to-active or active-to-revoked"
    );
    assert(
        !usedCredentialStatusCommandNonces.member(disclose(command.commandNonce)),
        "Credential-status command nonce already used"
    );
    assert(
        authorityRoots.member(disclose(command.namespaceHash)) &&
        credentialStatusRoots.member(disclose(command.namespaceHash)),
        "Namespace root records are not registered"
    );
    const authorityRoot = authorityRoots.lookup(disclose(command.namespaceHash));
    const statusRoot = credentialStatusRoots.lookup(disclose(command.namespaceHash));
    assert(
        command.governancePolicyHash == authorityRoot.governancePolicyHash &&
        command.authorityRootVersion == authorityRoot.rootVersion &&
        command.authorityRootSequence == authorityRoot.rootSequence,
        "Credential-status command authority root is stale or mismatched"
    );
    assert(
        command.credentialStatusRootSequence == statusRoot.rootSequence,
        "Credential-status command root sequence is stale"
    );
    assert(
        blockTimeGte(disclose(command.effectiveAt)),
        "Credential-status command is not yet effective"
    );

    const namespaceSigned =
        command.revocationAuthorityAccountCredentialCommitment == default<Bytes<32>> ||
        (command.credentialKind == 1 && command.expectedStatus == 0);
    if (disclose(namespaceSigned)) {
        assert(
            namespaceAuthority.leafVersion == 1 &&
            namespaceAuthority.authorityKind == 6 &&
            namespaceAuthority.namespaceHash == command.namespaceHash &&
            namespaceAuthority.governancePolicyHash == command.governancePolicyHash,
            "Credential issuer is outside the namespace capability-issuer scope"
        );
        assert(
            command.effectiveAt >= namespaceAuthority.validAfter &&
            command.effectiveAt < namespaceAuthority.validBefore,
            "Namespace capability issuer is outside its validity window"
        );
        const authorityCommitment = governanceActivatorLeafCommitment(namespaceAuthority);
        assert(
            namespaceAuthorityPath.leaf == authorityCommitment &&
            merkleTreePathRoot<20, Bytes<32>>(namespaceAuthorityPath) == authorityRoot.root,
            "Namespace capability issuer is not eligible under the current authority root"
        );
        if (disclose(command.credentialKind == 1)) {
            assert(
                command.expectedStatus == 0 &&
                command.revocationAuthorityAccountCredentialCommitment == command.credentialCommitment,
                "Account issuance must bind self-revocation authority"
            );
        }
        Schnorr_schnorrVerify<1>(
            runtimeCredentialStatusCommandMessage(command),
            signature,
            namespaceAuthority.publicKey
        );
    } else {
        const accountCommitment = runtimeAccountCredentialCommitment(accountAuthority);
        assert(
            accountCommitment == command.revocationAuthorityAccountCredentialCommitment &&
            accountAuthority.credentialVersion == 1 &&
            accountAuthority.target.namespaceHash == command.namespaceHash,
            "Runtime account authority does not match the status command"
        );
        assert(
            command.effectiveAt >= accountAuthority.issuedAt &&
            command.effectiveAt < accountAuthority.validBefore,
            "Runtime account authority is outside its validity window"
        );
        const activeAccountLeaf = runtimeCredentialStatusLeafCommitment(
            RuntimeCredentialStatusLeaf{
                leafVersion: 1,
                namespaceHash: command.namespaceHash,
                credentialKind: 1,
                credentialCommitment: accountCommitment,
                revocationAuthorityAccountCredentialCommitment: accountCommitment,
                statusIndex: accountAuthority.statusIndex,
                status: 1
            }
        );
        assert(
            accountAuthorityStatusPath.leaf == activeAccountLeaf &&
            merkleTreePathRoot<20, Bytes<32>>(accountAuthorityStatusPath) == statusRoot.root,
            "Runtime account authority is not active under the current status root"
        );
        Schnorr_schnorrVerify<1>(
            runtimeCredentialStatusCommandMessage(command),
            signature,
            accountAuthority.runtimePublicKey
        );
    }

    const currentLeaf = RuntimeCredentialStatusLeaf{
        leafVersion: 1,
        namespaceHash: command.namespaceHash,
        credentialKind: command.credentialKind,
        credentialCommitment: command.credentialCommitment,
        revocationAuthorityAccountCredentialCommitment:
            command.revocationAuthorityAccountCredentialCommitment,
        statusIndex: command.statusIndex,
        status: command.expectedStatus
    };
    if (disclose(command.expectedStatus == 0)) {
        assert(
            currentStatusPath.leaf == default<Bytes<32>>,
            "Credential issuance requires the exact empty status leaf"
        );
    } else {
        assert(
            currentStatusPath.leaf == runtimeCredentialStatusLeafCommitment(currentLeaf),
            "Credential revocation requires the exact active status leaf"
        );
    }
    assert(
        merkleTreePathRoot<20, Bytes<32>>(currentStatusPath) == statusRoot.root,
        "Credential status path does not match the exact current leaf and root"
    );
    const nextLeafCommitment = runtimeCredentialStatusLeafCommitment(
        RuntimeCredentialStatusLeaf{
            leafVersion: 1,
            namespaceHash: command.namespaceHash,
            credentialKind: command.credentialKind,
            credentialCommitment: command.credentialCommitment,
            revocationAuthorityAccountCredentialCommitment:
                command.revocationAuthorityAccountCredentialCommitment,
            statusIndex: command.statusIndex,
            status: command.nextStatus
        }
    );
    const nextStatusPath = MerkleTreePath<20, Bytes<32>>{
        leaf: nextLeafCommitment,
        path: currentStatusPath.path
    };
    const nextSequence = (statusRoot.rootSequence + 1) as Uint<64>;
    credentialStatusRoots.insert(
        disclose(command.namespaceHash),
        disclose(
            CredentialStatusRootRecord{
                root: merkleTreePathRoot<20, Bytes<32>>(nextStatusPath),
                rootSequence: nextSequence
            }
        )
    );
    usedCredentialStatusCommandNonces.insert(disclose(command.commandNonce));
    return disclose(nextSequence);
}
