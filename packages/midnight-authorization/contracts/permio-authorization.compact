export pure circuit runtimeCredentialStatusPathRoot(
    path: MerkleTreePath<20, Bytes<32>>
): MerkleTreeDigest {
    return merkleTreePathRoot<20, Bytes<32>>(path);
}

// Paths are leaf-first. Bind the physical Merkle position to the signed
// credential index; an empty leaf elsewhere in the same tree is not its slot.
export pure circuit runtimeCredentialStatusPathIndex(
    path: MerkleTreePath<20, Bytes<32>>
): Uint<64> {
    return (
        (path.path[0].goes_left ? 0 : 1) +
        (path.path[1].goes_left ? 0 : 2) +
        (path.path[2].goes_left ? 0 : 4) +
        (path.path[3].goes_left ? 0 : 8) +
        (path.path[4].goes_left ? 0 : 16) +
        (path.path[5].goes_left ? 0 : 32) +
        (path.path[6].goes_left ? 0 : 64) +
        (path.path[7].goes_left ? 0 : 128) +
        (path.path[8].goes_left ? 0 : 256) +
        (path.path[9].goes_left ? 0 : 512) +
        (path.path[10].goes_left ? 0 : 1024) +
        (path.path[11].goes_left ? 0 : 2048) +
        (path.path[12].goes_left ? 0 : 4096) +
        (path.path[13].goes_left ? 0 : 8192) +
        (path.path[14].goes_left ? 0 : 16384) +
        (path.path[15].goes_left ? 0 : 32768) +
        (path.path[16].goes_left ? 0 : 65536) +
        (path.path[17].goes_left ? 0 : 131072) +
        (path.path[18].goes_left ? 0 : 262144) +
        (path.path[19].goes_left ? 0 : 524288)
    ) as Uint<64>;
}

export pure circuit runtimeCredentialStatusLeafParent(
    path: MerkleTreePath<1, Bytes<32>>
): MerkleTreeDigest {
    return merkleTreePathRoot<1, Bytes<32>>(path);
}

export pure circuit runtimeCredentialStatusNodeParent(
    path: MerkleTreePath<1, MerkleTreeDigest>
): MerkleTreeDigest {
    return merkleTreePathRoot<1, MerkleTreeDigest>(path);
}

