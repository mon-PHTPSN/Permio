// Shared private view avoids duplicating the scope and signature circuits for
// capability and session issuance. The signed command pins the credential kind.
struct RuntimeScopedCredential {
    version: Uint<16>;
    commitment: Bytes<32>;
    message: Vector<1, Field>;
    target: TemplateRegistryTarget;
    instanceCommitment: Bytes<32>;
    contextHash: Bytes<32>;
    subject: Bytes<32>;
    parent: Bytes<32>;
    issuer: Bytes<32>;
    roots: RuntimeScopeRoots;
    counts: RuntimeScopeCounts;
    notBefore: Uint<64>;
    expiresAt: Uint<64>;
    issuedAt: Uint<64>;
    statusIndex: Uint<64>;
}

