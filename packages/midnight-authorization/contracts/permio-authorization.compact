    actionsCount: Uint<32>;
    resourceSelectorsCount: Uint<32>;
    resourcesCount: Uint<32>;
    purposesCount: Uint<32>;
    recipientKindsCount: Uint<32>;
    recipientsCount: Uint<32>;
    disclosurePolicyIdsCount: Uint<32>;
}

