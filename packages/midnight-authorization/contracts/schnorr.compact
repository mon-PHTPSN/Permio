pragma language_version >= 0.23;

module schnorr {
    import CompactStandardLibrary;

    export struct SchnorrSignature {
        announcement: JubjubPoint;
        response: Field;
    }

    struct SchnorrHashInput<#n> {
        ann_x: Field;
        ann_y: Field;
        pk_x: Field;
        pk_y: Field;
        msg: Vector<n, Field>;
    }

    witness getSchnorrReduction(challengeHash: Field): [Uint<7>, Uint<248>];

    export circuit schnorrVerify<#n>(
        msg: Vector<n, Field>,
        signature: SchnorrSignature,
        publicKey: JubjubPoint
    ): [] {
        const { announcement, response } = signature;
        assert(
            !(jubjubPointX(publicKey) == 0 && jubjubPointY(publicKey) == 1),
            "Governance activation public key must not be the identity point"
        );
        const fullChallenge: Field = transientHash<SchnorrHashInput<n>>(
            SchnorrHashInput<n>{
                ann_x: jubjubPointX(announcement),
                ann_y: jubjubPointY(announcement),
                pk_x: jubjubPointX(publicKey),
                pk_y: jubjubPointY(publicKey),
                msg: msg
            }
        );
        const TWO_248: Field =
            452312848583266388373324160190187140051835877600158453279131187530910662656 as Field;
        const [quotient, truncatedChallenge] = getSchnorrReduction(fullChallenge);

        assert(disclose(quotient) < 116, "Schnorr quotient out of range");
        assert(
            disclose(quotient) * TWO_248 + (disclose(truncatedChallenge) as Field) ==
                fullChallenge,
            "Invalid Schnorr challenge reduction"
        );

        const challenge: Field = disclose(truncatedChallenge) as Field;
        const expected: JubjubPoint = ecAdd(
            announcement,
            ecMul(publicKey, challenge)
        );
        const actual: JubjubPoint = ecMulGenerator(response);
        assert(
            jubjubPointX(actual) == jubjubPointX(expected) &&
            jubjubPointY(actual) == jubjubPointY(expected),
            "Invalid governance activation signature"
        );
    }

    export pure circuit schnorrChallenge(
        ann_x: Field,
        ann_y: Field,
        pk_x: Field,
        pk_y: Field,
        msg: Vector<1, Field>
    ): Field {
        return transientHash<SchnorrHashInput<1>>(
            SchnorrHashInput<1>{
                ann_x: ann_x,
                ann_y: ann_y,
                pk_x: pk_x,
                pk_y: pk_y,
                msg: msg
            }
        );
    }
}
