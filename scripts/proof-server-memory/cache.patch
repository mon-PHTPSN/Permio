+// Permio's opt-in memory experiment: cache handles, not ownership. An active
+// proof still owns its exact decoded key through Arc; completed proofs must
+// not leave several multi-GiB decoded keys alive solely for future reuse.
+type ProverKeyCache = LruCache<HashOutput, Weak<dyn Any + Send + Sync>>;
+
+fn cached_prover_key<T: Any + Send + Sync>(
+    cache: &mut ProverKeyCache,
+    hash: &HashOutput,
+) -> Option<Arc<T>> {
+    cache.get(hash)?.upgrade()?.downcast().ok()
