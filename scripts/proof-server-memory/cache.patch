+#[cfg(test)]
+mod weak_cache_tests {
+    use super::*;
+
+    #[test]
+    fn weak_cache_reuses_only_the_exact_live_key_and_type() {
+        let mut cache = ProverKeyCache::new(NonZeroUsize::new(PK_CACHE_SIZE).unwrap());
+        let hash = persistent_hash(b"public synthetic key one");
+        let other_hash = persistent_hash(b"public synthetic key two");
+        let key = Arc::new(vec![7u8; 1024]);
+        let erased: Arc<dyn Any + Send + Sync> = key.clone();
+        cache.put(hash, Arc::downgrade(&erased));
+        drop(erased);
+        let reused = cached_prover_key::<Vec<u8>>(&mut cache, &hash).unwrap();
+        assert!(Arc::ptr_eq(&key, &reused));
+        assert!(cached_prover_key::<Vec<u8>>(&mut cache, &other_hash).is_none());
+        assert!(cached_prover_key::<String>(&mut cache, &hash).is_none());
+    }
+
+    #[test]
+    fn weak_cache_does_not_keep_completed_key_alive() {
+        let mut cache = ProverKeyCache::new(NonZeroUsize::new(PK_CACHE_SIZE).unwrap());
+        let hash = persistent_hash(b"public synthetic completed key");
+        let key: Arc<dyn Any + Send + Sync> = Arc::new(vec![9u8; 1024]);
+        let weak = Arc::downgrade(&key);
+        cache.put(hash, weak.clone());
+        assert_eq!(Arc::strong_count(&key), 1);
+        drop(key);
+        assert!(weak.upgrade().is_none());
+        assert!(cached_prover_key::<Vec<u8>>(&mut cache, &hash).is_none());
+    }
+
+    #[test]
+    fn weak_cache_eviction_does_not_invalidate_in_flight_key() {
+        let mut cache = ProverKeyCache::new(NonZeroUsize::new(1).unwrap());
+        let first_hash = persistent_hash(b"public synthetic active key");
+        let next_hash = persistent_hash(b"public synthetic next key");
+        let active: Arc<dyn Any + Send + Sync> = Arc::new(vec![3u8; 1024]);
+        let next: Arc<dyn Any + Send + Sync> = Arc::new(vec![4u8; 1024]);
+        cache.put(first_hash, Arc::downgrade(&active));
+        cache.put(next_hash, Arc::downgrade(&next));
+        assert!(cached_prover_key::<Vec<u8>>(&mut cache, &first_hash).is_none());
+        assert_eq!(active.downcast_ref::<Vec<u8>>().unwrap()[0], 3);
+        assert!(cached_prover_key::<Vec<u8>>(&mut cache, &next_hash).is_some());
+    }
+}
